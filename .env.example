# Скопируй в .env и при необходимости поменяй значения.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- Postgres (используется контейнером db) ---
POSTGRES_USER=polza
POSTGRES_PASSWORD=polza_local_dev
POSTGRES_DB=polza

# Порт, на котором Postgres выставлен на хост-машину.
POSTGRES_PORT=5433

# --- Подключение приложения и скриптов загрузки ---
# Внутри docker compose хост — имя сервиса `db`.
DATABASE_URL=postgresql://polza:polza_local_dev@db:5432/polza

# Если запускаешь скрипты/Next.js локально (без Docker), а Postgres — в контейнере:
# DATABASE_URL=postgresql://polza:polza_local_dev@localhost:5433/polza

# --- Веб ---
WEB_PORT=3000

# Каталог с исходной выгрузкой (page_*.json, review.csv)
DATA_DIR=./data_pack
